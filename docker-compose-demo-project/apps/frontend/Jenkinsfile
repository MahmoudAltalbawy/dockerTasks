pipeline {
  agent any

  environment {
    DOCKERHUB_CREDS = credentials('docker-cred')
    SERVICE    = 'wave-frontend'
    APP_DIR    = 'docker-compose-demo-project/apps/frontend'
    IMAGE_NAME = "${DOCKERHUB_CREDS_USR}/${SERVICE}"
    IMAGE_TAG  = "${env.BUILD_NUMBER}"
    VITE_API_URL = 'http://localhost:3000'
  }

  stages {
    stage('Checkout') {
      steps { checkout scm }
    }

    stage('Build image') {
  steps {
    sh 'docker build --build-arg VITE_API_URL=$VITE_API_URL -t $IMAGE_NAME:$IMAGE_TAG $APP_DIR'
  }
}

    stage('Push image') {
      steps {
        sh '''
          echo "$DOCKERHUB_CREDS_PSW" | docker login -u "$DOCKERHUB_CREDS_USR" --password-stdin
          docker push $IMAGE_NAME:$IMAGE_TAG
        '''
      }
    }
    stage('Trigger compose update') {
  steps {
    build job: 'wave-update-compose-pipeline',
          parameters: [
            string(name: 'SERVICE',   value: env.SERVICE),
            string(name: 'IMAGE_TAG', value: env.IMAGE_TAG)
          ],
          wait: true
  }
}

  }

  

  post {
    always {
      sh 'docker logout || true'
      sh 'docker rmi $IMAGE_NAME:$IMAGE_TAG || true'
    }
  }
}