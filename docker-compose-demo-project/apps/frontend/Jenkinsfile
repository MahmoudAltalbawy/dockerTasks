pipeline {
  agent any

  environment {
    SERVICE    = 'wave-frontend'
    APP_DIR    = "docker-compose-demo-project/apps/frontend"
    IMAGE_NAME = "myuser/${SERVICE}"
    IMAGE_TAG  = "${env.BUILD_NUMBER}"
    CREDS_ID   = 'docker-cred'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Build image') {
      when {
        anyOf {
          changeset "docker-compose-demo-project/apps/frontend/**"
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        dir("${APP_DIR}") {
          sh "docker build -t ${IMAGE_NAME}:${IMAGE_TAG} ."
        }
      }
    }

    stage('Push image') {
      when {
        anyOf {
          changeset "docker-compose-demo-project/apps/frontend/**"
          triggeredBy 'UserIdCause'
        }
      }
      steps {
        withCredentials([usernamePassword(credentialsId: CREDS_ID,
                         usernameVariable: 'REG_USER',
                         passwordVariable: 'REG_PASS')]) {
          sh '''
            echo "$REG_PASS" | docker login -u "$REG_USER" --password-stdin
            docker push $IMAGE_NAME:$IMAGE_TAG
          '''
        }
      }
    }
  }

  post {
    always {
      sh 'docker logout || true'
      sh "docker rmi ${IMAGE_NAME}:${IMAGE_TAG} || true"
    }
  }
}